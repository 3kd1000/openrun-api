# --- Stage 1: Backend 빌드 스테이지 ---
# 경량화: gradle 이미지(850MB) → eclipse-temurin(450MB)
# 프로젝트에 gradlew가 있으므로 Gradle 이미지 불필요
# alpine은 arm64 미지원으로 일반 이미지 사용
FROM eclipse-temurin:17-jdk as api-builder

WORKDIR /app

# --- Gradle Wrapper 복사 ---
COPY gradlew .
COPY gradle gradle
RUN chmod +x ./gradlew

# --- 의존성 다운로드 (효율적인 캐싱 전략) ---
COPY build.gradle settings.gradle ./
COPY api/build.gradle ./api/

# Gradle 의존성 캐시 활용
RUN --mount=type=cache,target=/root/.gradle \
    ./gradlew dependencies --no-daemon 2>/dev/null || true

# --- 소스코드 복사 및 빌드 ---
COPY api/src ./api/src

# Gradle 빌드 (테스트 제외, 캐시 최대 활용, 병렬 빌드)
RUN --mount=type=cache,target=/root/.gradle \
    ./gradlew :api:build -x test --no-daemon --build-cache --parallel


# --- Stage 2: 최종 실행 이미지 생성 스테이지 ---
FROM eclipse-temurin:17-jre

WORKDIR /app

# --- 빌드 결과물 복사 ---
COPY --from=api-builder /app/api/build/libs/*.jar ./app.jar

# --- 포트 노출 및 애플리케이션 실행 ---
EXPOSE 8080

ENTRYPOINT ["java", "-Dspring.web.resources.static-locations=classpath:/META-INF/resources/,classpath:/resources/,classpath:/static/,classpath:/public/", "-jar", "app.jar"]
