# --- Stage 1: Admin Frontend 빌드 스테이지 ---
FROM node:22 as builder

WORKDIR /app/admin

# --- 의존성 설치 (효율적인 캐싱 전략) ---
COPY admin/package.json admin/package-lock.json ./
RUN npm ci --prefer-offline --no-audit

# --- 환경 파일 복사 (존재하는 파일만) ---
COPY admin/.env* ./

# --- 소스코드 복사 및 빌드 ---
COPY admin/ .

# 빌드 커맨드 (CI/CD에서 덮어씀: npm run build:develop)
ARG BUILD_COMMAND="npm run build"
RUN ${BUILD_COMMAND}

# 빌드 결과물 확인
RUN ls -la /app/admin/dist 2>/dev/null || echo "dist 폴더 없음 - 빌드 실패 가능성"


# --- Stage 2: 최종 실행 이미지 (Node.js serve) ---
FROM node:22-alpine

WORKDIR /app

# serve 패키지 설치
RUN npm install -g serve

# 빌드 결과물 복사
COPY --from=builder /app/admin/dist ./dist

# 포트 노출
EXPOSE 80

# SPA 라우팅 처리 (-s: SPA 모드, -l 80: 80 포트 listen)
ENTRYPOINT ["serve", "-s", "dist", "-l", "80"]
