# --- Stage 1: Frontend 빌드 스테이지 ---
FROM node:22 as builder

WORKDIR /app/front

# --- 의존성 설치 (효율적인 캐싱 전략) ---
COPY front/package.json front/package-lock.json ./
RUN npm ci --prefer-offline --no-audit

# --- 환경 파일 복사 (존재하는 파일만) ---
COPY front/.env* ./


# --- 소스코드 복사 및 빌드 ---
COPY front/ .

# 빌드 커맨드 (CI/CD에서 덮어씀: npm run build:develop)
ARG BUILD_COMMAND="npm run build"
RUN ${BUILD_COMMAND}

# 빌드 결과물 확인
RUN ls -la /app/front/dist 2>/dev/null || echo "dist 폴더 없음 - 빌드 실패 가능성"


# --- Stage 2: 최종 실행 이미지 (Express OG 서버) ---
FROM node:22-alpine

WORKDIR /app

# Express 설치 (동적 OG 태그 서빙용)
RUN npm install express

# 빌드 결과물 복사
COPY --from=builder /app/front/dist ./dist

# OG 서버 스크립트 복사
COPY front/og-server.js ./og-server.js

# 포트 노출
EXPOSE 80

# Express OG 서버 실행 (정적 파일 서빙 + 크롤러 동적 OG 태그)
ENTRYPOINT ["node", "og-server.js"]
